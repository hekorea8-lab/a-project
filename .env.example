# Do not commit a real value. Copy this file to .env and set values only there.
LAW_API_OC=
DART_API_KEY=
OPENAI_API_KEY=
# 기본 모델 실패 시에만 보조 모델로 한 번 재시도합니다. 기본 모델은 변경하지 않습니다.
MODEL_RETRY_ENABLED=true
MODEL_FALLBACK_NAME=gpt-5.6-sol
# LangSmith 추적은 기본적으로 꺼져 있으며, 키를 입력한 뒤 true로 켭니다.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=posco-accounting-tax-review
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_WORKSPACE_ID=
# 민감한 거래 사실·근거 원문은 기본적으로 trace에 숨깁니다.
LANGSMITH_HIDE_INPUTS=true
LANGSMITH_HIDE_OUTPUTS=true
EMBEDDING_MODEL=text-embedding-3-large
# off: 사용 안 함 / shadow: 후보·상태만 기록 / hybrid: 구조화 검색 보강 후보로 사용
EMBEDDING_RETRIEVAL_MODE=shadow
# shadow: 관찰만 / canary: 지정 질문·비율만 최종 반영 / hybrid: 전체 반영
EMBEDDING_ROLLOUT_STAGE=shadow
# canary 단계에서 벡터 검색을 최종 반영할 비율(0~100)
EMBEDDING_CANARY_PERCENT=0
# canary 단계에서 비율과 무관하게 반영할 질문 조각(쉼표 구분)
EMBEDDING_CANARY_QUERIES=
# 벡터 1차 후보 수. 최종 답변 수와 분리해 검색 누락을 줄입니다.
VECTOR_CANDIDATE_TOP_K=30
# 0이면 필터링하지 않고 점수만 기록합니다. 기준선 측정 후 조정합니다.
VECTOR_SIMILARITY_THRESHOLD=0
# HNSW 탐색 폭. 높일수록 recall이 좋아질 수 있으나 응답시간이 늘어납니다.
VECTOR_HNSW_EF_SEARCH=80
CHUNK_PROFILE=balanced
CHUNK_TARGET_TOKENS=650
CHUNK_MIN_TOKENS=300
CHUNK_MAX_TOKENS=1100
CHUNK_OVERLAP_TOKENS=120
RETRIEVAL_TOP_K=15
RERANK_TOP_K=6
CONTEXT_NEIGHBOR_COUNT=1
KNOWLEDGE_DB_PATH=data/knowledge.db
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DATABASE=
POSTGRES_USER=
POSTGRES_PASSWORD=
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# 외부 검색 저장소가 응답하지 않을 때의 최대 연결 대기시간과 재시도 억제시간
VECTOR_CONNECT_TIMEOUT_SECONDS=2
VECTOR_FAILURE_COOLDOWN_SECONDS=60
GRAPH_CONNECT_TIMEOUT_SECONDS=2
GRAPH_FAILURE_COOLDOWN_SECONDS=60

# Docker Compose 영속 저장소는 프로젝트의 .docker-data 아래에 생성됩니다.
# 호스트에서 FastAPI를 실행할 때는 아래처럼 localhost를 사용합니다.
# 컨테이너 안에서 FastAPI를 실행할 때는 각각 postgres, neo4j로 바꿉니다.
# POSTGRES_HOST=127.0.0.1
# NEO4J_URI=bolt://127.0.0.1:7687
API_BASE_URL=http://127.0.0.1:8000
ADMIN_DASHBOARD_USERNAME=admin
ADMIN_DASHBOARD_PASSWORD=

# 자본적·수익적 지출 검토 결과를 세무섹션으로 송부할 때만 입력합니다.
# 실제 값은 .env에만 입력하고, 이 파일에는 빈 값으로 둡니다.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
TAX_SECTION_EMAIL=
