<mxfile host="app.diagrams.net" modified="2026-09-07T00:00:00.000Z" agent="Codex" version="24.7.17">
  <diagram id="rag-workflow" name="RAG 검토 워크플로우">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="포스코퓨처엠 회계·세무 RAG 검토 워크플로우" style="text;html=1;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#17324d;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="720" height="40" as="geometry"/></mxCell>
        <mxCell id="start" value="사용자 자연어 질문&#xa;예: 리튬을 구매하면 어떤 회계기준이 적용되나요?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ddecff;strokeColor=#0874bd;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="110" width="230" height="70" as="geometry"/></mxCell>
        <mxCell id="track" value="사용자 선택 영역&#xa;회계 · 세무" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff4d6;strokeColor=#c58b12;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="340" y="105" width="150" height="80" as="geometry"/></mxCell>
        <mxCell id="planner" value="1. 검색 계획 생성&#xa;LLM이 거래 의미·적용 주제·공식 검색어만 설계&#xa;결론·조문번호는 만들지 않음" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f6ee;strokeColor=#31875d;fontSize=13;" vertex="1" parent="1"><mxGeometry x="560" y="95" width="260" height="100" as="geometry"/></mxCell>
        <mxCell id="fallback" value="계획 생성 실패 시&#xa;거래유형 규칙으로 대체&#xa;리튬 구매 → 원재료·재고자산·매입원가" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#7d8790;fontSize=12;dashed=1;" vertex="1" parent="1"><mxGeometry x="560" y="235" width="260" height="80" as="geometry"/></mxCell>
        <mxCell id="accounting" value="회계 검색 계획&#xa;후보: K-IFRS 제1002호 재고자산&#xa;검색어: 원재료 · 매입원가 · 순실현가능가치" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf6ff;strokeColor=#0874bd;fontSize=12;" vertex="1" parent="1"><mxGeometry x="890" y="75" width="280" height="100" as="geometry"/></mxCell>
        <mxCell id="tax" value="세무 검색 계획&#xa;후보: 부가가치세 매입세액&#xa;검색어: 매입세액공제 · 세금계산서 · 수입 부가가치세" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3ed;strokeColor=#c86a38;fontSize=12;" vertex="1" parent="1"><mxGeometry x="890" y="225" width="280" height="100" as="geometry"/></mxCell>
        <mxCell id="rag" value="2. Hybrid RAG&#xa;키워드/BM25 + Vector Search&#xa;문서유형·시행일·버전 필터&#xa;Child chunk Top-K → 재정렬 → 인접 문단 확장" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef2ff;strokeColor=#5969c7;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1240" y="135" width="270" height="125" as="geometry"/></mxCell>
        <mxCell id="evidence" value="3. Evidence Pack&#xa;실제 검색된 원문만 전달&#xa;기준서·문단·시행일·출처 metadata 보존" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4efff;strokeColor=#7e5bb7;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1240" y="355" width="270" height="90" as="geometry"/></mxCell>
        <mxCell id="answer" value="4. 기본 답변&#xa;핵심 안내 · 검토 내용 · 실제 citation&#xa;근거 부족 시 필요한 사실만 확인 요청" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ddecff;strokeColor=#0874bd;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="930" y="500" width="280" height="95" as="geometry"/></mxCell>
        <mxCell id="follow" value="후속 질문 3개&#xa;기준서·세법 요건 또는&#xa;거래 증빙 확인으로 연결" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#7d8790;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1240" y="515" width="220" height="70" as="geometry"/></mxCell>
        <mxCell id="button" value="사용자 클릭&#xa;‘포스코퓨처엠 관련 사항으로 검토’" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff4d6;strokeColor=#c58b12;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="540" y="510" width="220" height="90" as="geometry"/></mxCell>
        <mxCell id="company" value="5. 회사 특화 변환&#xa;일반 기준&#xa;→ 포스코퓨처엠 공개 사업자료 Context&#xa;→ 실제 거래 추가 확인사항&#xa;&#xa;공개자료는 결론 근거가 아닌 쟁점 발굴용" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f6ee;strokeColor=#31875d;fontSize=13;" vertex="1" parent="1"><mxGeometry x="180" y="675" width="360" height="140" as="geometry"/></mxCell>
        <mxCell id="company-source" value="회사 Context 저장소&#xa;사업보고서 · 분/반기보고서 · 감사보고서·주석&#xa;공식 IR · 공식 뉴스룸&#xa;기준기간 · 공시일 · 버전 · 신뢰도 관리" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#7d8790;fontSize=12;" vertex="1" parent="1"><mxGeometry x="610" y="690" width="310" height="105" as="geometry"/></mxCell>
        <mxCell id="end" value="회사 특화 답변&#xa;일반 기준과 실제 거래 확인사항을 분리" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ddecff;strokeColor=#0874bd;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1000" y="695" width="270" height="90" as="geometry"/></mxCell>
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#506780;" edge="1" parent="1" source="start" target="track"><mxGeometry relative="1" as="geometry"/></mxCell>
