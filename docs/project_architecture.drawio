  <diagram id="current-chat-runtime" name="04 현재 코드 — 챗봇 실행 그래프">
    <mxGraphModel dx="1800" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="t" value="현재 코드 실행 그래프 — /knowledge-chat 및 거래 AI 검토" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=25;fontStyle=1;fontColor=#102F49;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1100" height="40" as="geometry"/></mxCell>
        <mxCell id="note" value="보라색 노드만 LLM 호출입니다. 별표(★)는 실제 HTTP 요청이 종료되어 화면으로 결과 또는 오류가 반환되는 지점입니다." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=14;fontColor=#5D7182;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="1300" height="28" as="geometry"/></mxCell>
        <mxCell id="user" value="사용자 질문&#xa;첨부파일 · 대화 문맥" style="ellipse;whiteSpace=wrap;html=1;fillColor=#0874BD;strokeColor=#075F9F;fontColor=#FFFFFF;fontStyle=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="50" y="180" width="155" height="80" as="geometry"/></mxCell>
        <mxCell id="api" value="POST /knowledge-chat" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F4FD;strokeColor=#0874BD;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="270" y="192" width="185" height="56" as="geometry"/></mxCell>
        <mxCell id="calc" value="계산형 질의?&#xa;특정 세목·입력값 판별" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF3D7;strokeColor=#D69A23;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="520" y="160" width="175" height="115" as="geometry"/></mxCell>
        <mxCell id="deterministic" value="결정적 세액·기한 계산&#xa;(LLM 호출 없음)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4FBF7;strokeColor=#35A46E;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="760" y="105" width="210" height="72" as="geometry"/></mxCell>
        <mxCell id="endcalc" value="★ A · 계산 결과 반환&#xa;LLM 없이 종료" style="shape=mxgraph.basic.star;whiteSpace=wrap;html=1;fillColor=#FCE8A7;strokeColor=#C78E00;fontColor=#6B4B00;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1050" y="105" width="165" height="80" as="geometry"/></mxCell>
        <mxCell id="search" value="로컬 근거 검색&#xa;SQLite · Hybrid Search&#xa;(LLM 호출 없음)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#35A46E;fontSize=14;" vertex="1" parent="1"><mxGeometry x="760" y="265" width="210" height="82" as="geometry"/></mxCell>
        <mxCell id="context" value="첨부 정리 + 읽기 전용 내부 조회&#xa;PDF/TXT/EML/이미지 · PostgreSQL&#xa;(LLM 호출 없음)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#35A46E;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1040" y="265" width="235" height="82" as="geometry"/></mxCell>
        <mxCell id="mode" value="전문가 검토 조건?&#xa;판단 의도 + 거래 단서&#xa;또는 첨부파일" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF3D7;strokeColor=#D69A23;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1335" y="250" width="180" height="112" as="geometry"/></mxCell>
        <mxCell id="expertPrompt" value="전문가 검토 지시문 구성&#xa;(LLM 호출 없음)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9B69BF;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1320" y="430" width="195" height="65" as="geometry"/></mxCell>
        <mxCell id="simplePrompt" value="일반 질의 지시문 구성&#xa;(LLM 호출 없음)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9B69BF;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1040" y="430" width="195" height="65" as="geometry"/></mxCell>
        <mxCell id="llmchat" value="LLM 호출&#xa;ChatOpenAI Responses API&#xa;answer_natural_language_question&#xa;max_retries=0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7047A8;strokeColor=#5A328D;fontColor=#FFFFFF;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1180" y="555" width="230" height="100" as="geometry"/></mxCell>
        <mxCell id="validate" value="JSON 파싱 + 근거 ID 허용목록 검증&#xa;허용되지 않은 ID는 응답 연결에서 제거" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4ECFB;strokeColor=#9B69BF;fontSize=13;" vertex="1" parent="1"><mxGeometry x="900" y="720" width="230" height="72" as="geometry"/></mxCell>
        <mxCell id="fallback" value="근거 기반 Fallback&#xa;AI 오류 시 검색 근거로 응답&#xa;(LLM 재호출 없음)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2F2;strokeColor=#D85B5B;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1190" y="720" width="220" height="72" as="geometry"/></mxCell>
        <mxCell id="endchat" value="★ B · 채팅 응답 반환&#xa;분석 기록 저장 후 종료" style="shape=mxgraph.basic.star;whiteSpace=wrap;html=1;fillColor=#FCE8A7;strokeColor=#C78E00;fontColor=#6B4B00;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="905" y="860" width="175" height="82" as="geometry"/></mxCell>
        <mxCell id="endfallback" value="★ C · Fallback 응답 반환&#xa;오류를 사용자에게 전달하지 않고 종료" style="shape=mxgraph.basic.star;whiteSpace=wrap;html=1;fillColor=#FCE8A7;strokeColor=#C78E00;fontColor=#6B4B00;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1190" y="860" width="175" height="82" as="geometry"/></mxCell>
        <mxCell id="inputError" value="★ E · 검색/첨부 검증 오류&#xa;EvidenceSearchError: 503&#xa;잘못된 첨부: 오류 응답" style="shape=mxgraph.basic.star;whiteSpace=wrap;html=1;fillColor=#FFF2F2;strokeColor=#D85B5B;fontColor=#8D2E2E;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="735" y="405" width="185" height="88" as="geometry"/></mxCell>
        <mxCell id="reportStart" value="선택된 위험 거래" style="ellipse;whiteSpace=wrap;html=1;fillColor=#0874BD;strokeColor=#075F9F;fontColor=#FFFFFF;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="600" width="155" height="70" as="geometry"/></mxCell>
