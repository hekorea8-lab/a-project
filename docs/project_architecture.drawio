  <diagram id="business-workflow" name="03 목표 업무 흐름 (PRD)">
    <mxGraphModel dx="1800" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="p3title" value="월 마감 사전검증 — 핵심 업무 흐름" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=26;fontStyle=1;fontColor=#102F49;" vertex="1" parent="1"><mxGeometry x="45" y="25" width="900" height="40" as="geometry"/></mxCell>
        <mxCell id="actorLane" value="담당자" style="swimlane;horizontal=0;startSize=42;rounded=1;html=1;fillColor=#E8F4FD;strokeColor=#78B8E0;fontColor=#075F9F;fontStyle=1;fontSize=16;" vertex="1" parent="1"><mxGeometry x="45" y="100" width="1520" height="190" as="geometry"/></mxCell>
        <mxCell id="systemLane" value="시스템" style="swimlane;horizontal=0;startSize=42;rounded=1;html=1;fillColor=#EEF9F3;strokeColor=#8DCFA9;fontColor=#207447;fontStyle=1;fontSize=16;" vertex="1" parent="1"><mxGeometry x="45" y="320" width="1520" height="340" as="geometry"/></mxCell>
        <mxCell id="aiLane" value="AI·근거 검색" style="swimlane;horizontal=0;startSize=42;rounded=1;html=1;fillColor=#F4ECFB;strokeColor=#C7A4DF;fontColor=#7047A8;fontStyle=1;fontSize=16;" vertex="1" parent="1"><mxGeometry x="45" y="690" width="1520" height="230" as="geometry"/></mxCell>

        <mxCell id="selectMonth" value="1. 법인 · 회계월 · 사업장 선택" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0874BD;fontSize=14;fontStyle=1;" vertex="1" parent="actorLane"><mxGeometry x="75" y="60" width="210" height="70" as="geometry"/></mxCell>
        <mxCell id="uploadFile" value="2. SAP 원장 업로드&#xa;Excel / CSV" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0874BD;fontSize=14;fontStyle=1;" vertex="1" parent="actorLane"><mxGeometry x="360" y="60" width="190" height="70" as="geometry"/></mxCell>
        <mxCell id="reviewResult" value="8. AI 잠정 의견 검토&#xa;사실 · 근거 · 불확실성 확인" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0874BD;fontSize=14;fontStyle=1;" vertex="1" parent="actorLane"><mxGeometry x="965" y="60" width="220" height="70" as="geometry"/></mxCell>
        <mxCell id="confirm" value="9. 최종 판단 · 조치 확정&#xa;판단근거 · 담당자 · 기한" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0874BD;strokeColor=#075F9F;fontColor=#FFFFFF;fontSize=14;fontStyle=1;" vertex="1" parent="actorLane"><mxGeometry x="1260" y="60" width="210" height="70" as="geometry"/></mxCell>

        <mxCell id="version" value="3. 업로드 원본·버전 저장&#xa;최신본만 분석 기준 버전" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#35A46E;fontSize=14;" vertex="1" parent="systemLane"><mxGeometry x="360" y="55" width="190" height="78" as="geometry"/></mxCell>
        <mxCell id="masterApply" value="최신 특수관계자 Master 적용" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#35A46E;fontSize=13;" vertex="1" parent="systemLane"><mxGeometry x="360" y="205" width="190" height="65" as="geometry"/></mxCell>
        <mxCell id="ruleCheck" value="4. 규칙 기반 Risk Check&#xa;변동성 · 신규/비반복 · 3억원 이상" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#35A46E;fontSize=14;" vertex="1" parent="systemLane"><mxGeometry x="645" y="55" width="220" height="78" as="geometry"/></mxCell>
        <mxCell id="riskScore" value="5. Risk Score 산정&#xa;High / Medium / Low" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DFF3E8;strokeColor=#258A59;strokeWidth=2;fontSize=14;fontStyle=1;" vertex="1" parent="systemLane"><mxGeometry x="940" y="55" width="190" height="78" as="geometry"/></mxCell>
        <mxCell id="reportSave" value="10. 검토 결과·조치 이력 저장&#xa;Dashboard · 월/분기/연말 Report" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DFF3E8;strokeColor=#258A59;strokeWidth=2;fontSize=14;fontStyle=1;" vertex="1" parent="systemLane"><mxGeometry x="1235" y="55" width="235" height="78" as="geometry"/></mxCell>
        <mxCell id="repeatRule" value="반복거래는 특수관계자 신규·비반복 선별에서 제외&#xa;단, 과거 패턴 이탈 시 변동성 후보로 유지" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4FBF7;strokeColor=#8DCFA9;fontColor=#207447;fontSize=12;" vertex="1" parent="systemLane"><mxGeometry x="645" y="205" width="485" height="65" as="geometry"/></mxCell>

        <mxCell id="evidenceSearch" value="6. 승인된 근거 검색&#xa;정확 + 키워드 + 벡터 + 관계 확장" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9B69BF;fontSize=14;" vertex="1" parent="aiLane"><mxGeometry x="640" y="60" width="230" height="85" as="geometry"/></mxCell>
        <mxCell id="aiReview" value="7. Evidence Pack 기반 AI 검토&#xa;회계·세무 쟁점 · 반대 논리 · 증빙 · 조치" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7047A8;strokeColor=#5A328D;fontColor=#FFFFFF;fontSize=14;fontStyle=1;" vertex="1" parent="aiLane"><mxGeometry x="940" y="60" width="245" height="85" as="geometry"/></mxCell>
        <mxCell id="citationGuard" value="핵심 주장에 근거 문서 ID · URL · 시행일/버전 연결&#xa;근거가 부족하면 확정하지 않고 추가 확인사항 표시" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9B69BF;fontColor=#7047A8;fontSize=12;" vertex="1" parent="aiLane"><mxGeometry x="1235" y="60" width="235" height="85" as="geometry"/></mxCell>

        <mxCell id="p3e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#5A7188;strokeWidth=2;" edge="1" parent="actorLane" source="selectMonth" target="uploadFile"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#5A7188;strokeWidth=2;" edge="1" parent="1" source="uploadFile" target="version"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#35A46E;strokeWidth=2;" edge="1" parent="systemLane" source="version" target="ruleCheck"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#35A46E;" edge="1" parent="systemLane" source="masterApply" target="ruleCheck"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#35A46E;strokeWidth=2;" edge="1" parent="systemLane" source="ruleCheck" target="riskScore"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#9B69BF;strokeWidth=2;" edge="1" parent="1" source="riskScore" target="evidenceSearch"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3e7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#9B69BF;strokeWidth=2;" edge="1" parent="aiLane" source="evidenceSearch" target="aiReview"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3e8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#9B69BF;" edge="1" parent="aiLane" source="aiReview" target="citationGuard"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3e9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#5A7188;strokeWidth=2;" edge="1" parent="1" source="aiReview" target="reviewResult"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3e10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#5A7188;strokeWidth=2;" edge="1" parent="actorLane" source="reviewResult" target="confirm"><mxGeometry relative="1" as="geometry"/></mxCell>
