  <diagram id="runtime-audit" name="05 상태·루프·중단점 감사">
    <mxGraphModel dx="1800" dy="1050" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="at" value="현재 코드 감사 — State, 되돌림, LLM 경계, ★ 종료점" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=25;fontStyle=1;fontColor=#102F49;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="40" as="geometry"/></mxCell>
        <mxCell id="uiState" value="UI State (브라우저 메모리)&#xa;history: 최근 3개 대화&#xa;risk: 분석 결과&#xa;selected: 선택 거래&#xa;chatAttachments: 첨부" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#E8F4FD;strokeColor=#0874BD;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="75" y="145" width="240" height="145" as="geometry"/></mxCell>
        <mxCell id="request" value="HTTP 요청 단위 처리&#xa;백엔드는 요청 간 AI State를 유지하지 않음" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#35A46E;fontSize=14;" vertex="1" parent="1"><mxGeometry x="400" y="175" width="240" height="82" as="geometry"/></mxCell>
        <mxCell id="aiOutput" value="AI 생성 출력(JSON)&#xa;review 또는 answer&#xa;응답 데이터이지 다음 노드가 읽는 Agent State가 아님" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#F4ECFB;strokeColor=#9B69BF;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="735" y="145" width="260" height="145" as="geometry"/></mxCell>
        <mxCell id="persist" value="영속 저장&#xa;Risk 분석: PostgreSQL 저장&#xa;챗봇: 분석용 요약 기록&#xa;AI review 자체의 자동 재투입 없음" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#FFF5E5;strokeColor=#D69A23;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1090" y="145" width="250" height="145" as="geometry"/></mxCell>
        <mxCell id="noState" value="AI가 만든 장기 State 칸&#xa;현재 구현: 없음&#xa;LangGraph State · 계획-실행 메모리 · 자동 재검토 큐는 코드에 없음" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2F2;strokeColor=#D85B5B;fontColor=#8D2E2E;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1410" y="145" width="200" height="145" as="geometry"/></mxCell>
        <mxCell id="refreshState" value="별도 갱신 상태 파일&#xa;running · completed · failed&#xa;법령 수집 진행 표시용&#xa;AI가 만든 State 아님" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#FFF5E5;strokeColor=#D69A23;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1410" y="350" width="200" height="130" as="geometry"/></mxCell>
        <mxCell id="userLoop" value="사용자 후속 질문 버튼&#xa;새 HTTP 요청으로 돌아감&#xa;history 최근 3개만 전달" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0874BD;fontSize=14;" vertex="1" parent="1"><mxGeometry x="100" y="490" width="220" height="80" as="geometry"/></mxCell>
        <mxCell id="loopLabel" value="되돌림은 사용자 입력에 의한 새 요청이며,&#xa;LLM이 스스로 이전 단계로 되돌아가 재검색·재호출하는 루프는 없음" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4FBF7;strokeColor=#35A46E;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="430" y="490" width="390" height="80" as="geometry"/></mxCell>
        <mxCell id="retryChat" value="챗봇 LLM 재시도: 0회&#xa;실패하면 Fallback으로 종료 ★ C" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2F2;strokeColor=#D85B5B;fontSize=14;" vertex="1" parent="1"><mxGeometry x="920" y="485" width="230" height="85" as="geometry"/></mxCell>
        <mxCell id="retryReview" value="거래 검토 LLM 재시도: 최대 1회&#xa;그 뒤 성공 JSON 또는 503 종료 ★ D" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2F2;strokeColor=#D85B5B;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1230" y="485" width="275" height="85" as="geometry"/></mxCell>
        <mxCell id="star" value="★ 실제 중단점&#xa;A 계산형 결과&#xa;B 정상 채팅 응답&#xa;C Fallback 응답&#xa;D 거래 검토 응답/503&#xa;사람 승인 대기 노드: 없음" style="shape=mxgraph.basic.star;whiteSpace=wrap;html=1;fillColor=#FCE8A7;strokeColor=#C78E00;fontColor=#6B4B00;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="645" y="700" width="300" height="175" as="geometry"/></mxCell>
        <mxCell id="a1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#5A7188;strokeWidth=2;" edge="1" parent="1" source="uiState" target="request"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#9B69BF;strokeWidth=2;" edge="1" parent="1" source="request" target="aiOutput"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#D69A23;" edge="1" parent="1" source="aiOutput" target="persist"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a4" value="사용자가 다시 질문" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;startArrow=block;startFill=1;strokeColor=#0874BD;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="userLoop" target="uiState"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#35A46E;strokeWidth=2;" edge="1" parent="1" source="userLoop" target="loopLabel"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
